#!/usr/bin/env bash
#
# dsh-jev-kit commit-msg — does the message describe this diff?
#
# The two questions are the ones a reviewer asks first: does the message match what
# changed, and does the diff contain anything the message does not account for.
# Together they catch the "顺手改了点别的" commit before it enters history.
#
# $1 is the path to the commit message file (git's contract).
set -uo pipefail
[ "${JEV_SKIP_CHECKS:-0}" = "1" ] && exit 0
[ "${JEV_SKIP_COMMIT_MSG:-0}" = "1" ] && exit 0

message_file="${1:-}"
[ -n "$message_file" ] && [ -f "$message_file" ] || exit 0
# A comment-only or empty message (e.g. --amend --no-edit) has nothing to judge.
message=$(grep -v '^#' "$message_file" | sed '/^[[:space:]]*$/d' || true)
[ -z "$message" ] && exit 0

# Judge the diff the message is *about* — generated artifacts excluded.
#
# `lib/` and `*.map` are the compiled twin of a source change already in this same diff,
# and no commit message can describe a minified source map. Measured on this repository:
# 15 of 15 source-map hunks came back `unrelated` while the source hunks beside them were
# fine, so every commit that refreshed `lib/` read as 夹带无关改动 — a false positive
# that had been invisible only because the oversized judgment used to fail silently.
#
# Deliberately *not* the `.jev-kit-skip` list the push scan uses: that one also skips
# tests, docs and fixtures, because those necessarily contain credential-shaped text.
# The message check has no such excuse — tests and docs are exactly where 顺手改了点别的
# hides, so they stay in scope here.
skip_pathspecs=(":(exclude)lib/" ":(exclude)dist/" ":(exclude)build/" ":(exclude)*.map" ":(exclude)*.min.js")
diff=$(git diff --cached --no-color -U0 -- . "${skip_pathspecs[@]}" || true)
[ -z "$diff" ] && exit 0

payload=$(DIFF="$diff" MSG="$message" python3 -c 'import json,os; print(json.dumps({"message": os.environ["MSG"], "diff": os.environ["DIFF"]}))' 2>/dev/null || true)
[ -n "$payload" ] || exit 0

response=$(curl -sS -m 120 -X POST "${JEV_KIT_COMMIT_ENDPOINT:-http://127.0.0.1:3080/dsh-jev-kit/api/check-commit}" \
  -H 'content-type: application/json' -d "$payload" 2>/dev/null || true)
if [ -z "$response" ]; then
  echo "jev-kit commit-msg: ⚠️ 判定服务不可达，本次跳过（不代表信息与 diff 相符）。" >&2
  exit 0
fi

read -r flagged failed <<EOF
$(printf '%s' "$response" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("flagged",0), d.get("failed",0))' 2>/dev/null || echo "0 0")
EOF
# A unit the model never judged is not a match: say so rather than passing quietly.
if [ "${failed:-0}" != "0" ]; then
  echo "jev-kit commit-msg: ⚠️ 有 $failed 条**未能判定**（模型没回答）——本次不阻塞，但不代表信息与 diff 相符。" >&2
  printf '%s' "$response" | python3 -c '
import json, sys
for why in (json.load(sys.stdin).get("failures") or [])[:5]: print("    · %s" % why, file=sys.stderr)
' 2>/dev/null || true
fi
[ "${flagged:-0}" = "0" ] && exit 0

echo "" >&2
printf '%s' "$response" | python3 -c '
import json, sys
data = json.load(sys.stdin)
print("jev-kit commit-msg: 提交信息与 diff 可能不相符：", file=sys.stderr)
for finding in data.get("findings", []):
    print("  · %s" % finding.get("headline"), file=sys.stderr)
' 2>/dev/null
echo "  确认无误：JEV_ALLOW_COMMIT=1 git commit，或 JEV_SKIP_COMMIT_MSG=1。" >&2
[ "${JEV_ALLOW_COMMIT:-0}" = "1" ] && exit 0
exit 1
