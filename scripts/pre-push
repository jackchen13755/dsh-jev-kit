#!/usr/bin/env bash
#
# dsh-jev-kit pre-push hook — semantic privacy scan of what is about to be pushed.
#
# Why a hook: the privacy channel is the toolkit's most valuable judgment, and it
# was called **twice** in an entire working session because a tool only fires when
# a model remembers to ask. A hook fires whether or not anyone remembers — the same
# reason the lens's command guard is useful.
#
# What it checks: the commits actually being pushed (`<remote-sha>..<local-sha>`),
# added lines only. Not the working tree, not the whole history.
#
# Failure policy — deliberately asymmetric:
#   · plugin unreachable  → **warn and allow**. A scanner that blocks pushes when
#     it is down is worse than no scanner: it trains people to use --no-verify.
#   · findings            → **block**, with the excerpts and an explicit escape
#     hatch (`JEV_ALLOW_PUSH=1 git push`), because a bypass should be a decision
#     someone makes on purpose, not a habit.
#   · zero findings       → allow silently.
#
# Install (per repository):
#   bash scripts/install-hooks.sh
#
# Environment:
#   JEV_KIT_ENDPOINT   default http://127.0.0.1:3080/dsh-jev-kit/api/scan-private
#   JEV_SKIP_PRIVACY=1 skip this hook entirely (no request is made)
#   JEV_ALLOW_PUSH=1   run the scan, report findings, but do not block
#
set -uo pipefail

ENDPOINT="${JEV_KIT_ENDPOINT:-http://127.0.0.1:3080/dsh-jev-kit/api/scan-private}"
[ "${JEV_SKIP_PRIVACY:-0}" = "1" ] && exit 0

# The hook's stdin is one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# An all-zero remote sha means "new branch": there is no remote side to diff from.
range=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ -z "${local_sha:-}" ]; then continue
  fi
  case "${remote_sha:-}" in
    ""|0000000000000000000000000000000000000000)
      # New branch: compare against the merge base with the default branch when we
      # can find one, else the last commit only.
      base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || git rev-parse "$local_sha^" 2>/dev/null || echo "")
      [ -n "$base" ] && range="$base..$local_sha"
      ;;
    *)
      range="$remote_sha..$local_sha"
      ;;
  esac
  [ -n "$range" ] && break
done

if [ -z "$range" ]; then
  echo "jev-kit pre-push: 无法确定推送范围，跳过扫描（不阻塞）" >&2
  exit 0
fi

# Per-repository exemptions. A repository whose content is credential-shaped by
# design (a privacy-scanner fixture corpus, a security test suite) would otherwise be
# unable to push at all — measured: this hook blocked its own repository's push on the
# first real use. `.jev-kit-skip` holds git pathspecs, one per line, `#` comments.
# Bash 3.2 (macOS) treats an empty array as unbound under `set -u`, so the count is
# tracked explicitly and the array is only expanded when it is non-empty.
skip_count=0
skip_args=""
skip_file="$(git rev-parse --show-toplevel 2>/dev/null)/.jev-kit-skip"
if [ -f "$skip_file" ]; then
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    : "$((skip_count += 1))"
  done < "$skip_file"
  # Re-read into positional parameters rather than an array (same reason).
  set -- 
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    set -- "$@" ":(exclude)$line"
  done < "$skip_file"
  skip_args="$*"
  [ "$skip_count" -gt 0 ] && echo "jev-kit pre-push: 按 .jev-kit-skip 排除 $skip_count 条路径" >&2
fi

# Send the RAW diff, headers included. Filtering it down to added lines first looked
# tidier and broke the scan: the route recognises a diff by its `diff --git` / `@@`
# headers, so a stripped diff fell back to prose splitting — which truncates each
# block at 1500 characters and drops file provenance. The result was a hook that
# reported "0 findings" on a commit that plainly contains a credential.
if [ "$skip_count" -gt 0 ]; then
  # shellcheck disable=SC2086
  diff=$(git diff --no-color -U0 "$range" -- . $(printf '%s\n' "$skip_args") 2>/dev/null || git diff --no-color -U0 "$range" 2>/dev/null || true)
else
  diff=$(git diff --no-color -U0 "$range" 2>/dev/null || true)
fi
if [ -z "$diff" ]; then
  exit 0   # nothing changed: nothing to leak
fi
# Added lines only, for the cheap "is there anything to scan" decision.
added=$(printf '%s' "$diff" | grep -cE '^\+' || true)
if [ "${added:-0}" -le 1 ]; then
  exit 0
fi

# Bound what goes over the wire (the route allows 2 MB; scanning is capped by items
# anyway). Truncation is announced: a scan that silently looked at half the diff
# would report "clean" about text it never read.
max_bytes="${JEV_MAX_DIFF_BYTES:-1000000}"
if [ "$(printf '%s' "$diff" | wc -c | tr -d ' ')" -gt "$max_bytes" ]; then
  echo "jev-kit pre-push: ⚠️ diff 超过 ${max_bytes} 字节，只扫描前 ${max_bytes} 字节（其余未扫描）" >&2
  diff=$(printf '%s' "$diff" | head -c "$max_bytes")
fi

# JSON-encode without depending on jq (python3 ships with the harness).
payload=$(DIFF="$diff" python3 -c 'import json,os; print(json.dumps({"diff": os.environ["DIFF"]}))' 2>/dev/null) || {
  echo "jev-kit pre-push: 无法构造请求体（缺 python3？），跳过扫描（不阻塞）" >&2
  exit 0
}

# ── 第一层：正则（形状） ───────────────────────────────────────────────
#
# Two layers, because they catch different things and the measurements said so:
# a bare `db.acme-corp.internal` in a config file scored **0.29** on the model's
# "does this reveal internal information?" question — it is a *shape*, and shapes are
# what rules are for. A sentence like "服务 sgrl-billing-v2 部署在集群 acme-prod-2"
# scored **0.88** — that is *meaning*, and it is what the model is for. Running only
# the model missed the first; running only rules misses the second.
token_hits=$(printf '%s' "$diff" | grep -nEi 'ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|sk_live_[A-Za-z0-9]{10,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|MIIE[A-Za-z0-9+/]{20,}|BEGIN [A-Z ]*PRIVATE KEY' | head -3 || true)
# The dotted-name rule targets hostnames, and a hostname never contains an underscore
# (it is not a legal character there — which is exactly why `private_scan.internal` is a
# settings key and not a machine). Without that exclusion this layer flags the kit's own
# per-axis threshold key, and `.jev-kit-skip` can only ever be a per-file patch for it:
# every new source file that mentions the key would need an exemption. What the exclusion
# drops is counted and reported on every push, so it stays auditable rather than silent.
path_re='^\+.*/Users/[a-z][a-z0-9._-]+|^\+.*[A-Za-z0-9._-]+\.(internal|corp|intra)\b'
path_raw=$(printf '%s' "$diff" | grep -nE "$path_re" || true)
path_hits=$(printf '%s' "$path_raw" | grep -vE '[A-Za-z0-9.-]*_[A-Za-z0-9._-]*\.(internal|corp|intra)\b' | head -3 || true)
path_skipped=$(printf '%s' "$path_raw" | grep -cE '[A-Za-z0-9.-]*_[A-Za-z0-9._-]*\.(internal|corp|intra)\b' || true)
if [ "${path_skipped:-0}" != "0" ]; then
  echo "jev-kit pre-push: 按「主机名不含下划线」跳过 $path_skipped 处标识符形状（settings key 一类，不是主机名）" >&2
fi
if [ -n "$token_hits$path_hits" ]; then
  echo "" >&2
  echo "jev-kit pre-push: 正则层发现疑似凭据/内网形态（这一层不看语义，只看形状）：" >&2
  [ -n "$token_hits" ] && printf '%s\n' "$token_hits" | sed 's/^/    token: /' >&2
  [ -n "$path_hits" ] && printf '%s\n' "$path_hits" | sed 's/^/    path : /' >&2
  echo "  这是形状匹配，请确认是否为夹具/文档示例。" >&2
  if [ "${JEV_ALLOW_PUSH:-0}" != "1" ]; then
    echo "  确认后重推：JEV_ALLOW_PUSH=1 git push" >&2
    exit 1
  fi
fi

# ── 第二层：模型（语义） ───────────────────────────────────────────────
response=$(curl -sS -m 90 -X POST "$ENDPOINT" -H 'content-type: application/json' -d "$payload" 2>/dev/null)
if [ -z "$response" ]; then
  echo "jev-kit pre-push: ⚠️ 扫描器不可达（$ENDPOINT）——本次不阻塞推送。" >&2
  echo "         启动方式：cd ~/Desktop/dsh/github/dsh-jev-kit && dsh web（插件随宿主启动）" >&2
  exit 0
fi

# A failed request is NOT a clean diff. Reading a 400 as "flagged 0" is exactly the
# silent-pass this hook exists to prevent, so an unusable answer warns loudly and
# lets the push through on purpose (visible fail-open, never invisible).
verdict=$(printf '%s' "$response" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("unparsable 0 0"); raise SystemExit
if data.get("ok") is not True:
    print("error %s 0" % (data.get("error") or "unknown"))
else:
    print("ok %s %s" % (data.get("flagged", 0), data.get("failed", 0)))
' 2>/dev/null || echo "unparsable 0 0")

# Three parts: status, flagged, failed. `failed` counts units the model never judged
# (a 400 for an oversized unit, a timeout, a breaker) — reading `flagged: 0` beside a
# non-zero `failed` as "clean" is the silent pass this hook exists to prevent, and it
# lands hardest on the largest diffs.
set -- $verdict
status="$1"; flagged="${2:-0}"; failed="${3:-0}"

case "$status" in
  ok)
    if [ "$failed" != "0" ]; then
      echo "jev-kit pre-push: ⚠️ 有 $failed 条**未能判定**（模型没回答），本次不阻塞推送——但它不等于干净，请看一眼下面的原因。" >&2
      printf '%s' "$response" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for why in (data.get("failures") or [])[:5]: print("    · %s" % why, file=sys.stderr)
' 2>/dev/null || true
      [ "$flagged" = "0" ] && exit 0
    fi
    [ "$flagged" = "0" ] && exit 0
    ;;
  *)
    echo "jev-kit pre-push: ⚠️ 扫描未能完成（$verdict）——本次不阻塞推送，但**这不代表 diff 干净**。" >&2
    exit 0
    ;;
esac
if [ "$flagged" = "0" ]; then exit 0; fi

echo "" >&2
printf '%s' "$response" | python3 -c '
import json, sys
# No backslashes inside f-string expressions (Python < 3.12 rejects them): the
# first version of this printer died with a SyntaxError and printed nothing, which
# would have looked like "the hook ran and had nothing to say".
data = json.load(sys.stdin)
count = data.get("flagged", 0)
print("jev-kit pre-push: 语义隐私扫描发现 %s 处疑似泄漏（正则扫描是另一层，请照跑）" % count, file=sys.stderr)
for finding in data.get("findings", []):
    where = finding.get("where") or "(no location)"
    headline = finding.get("headline") or ""
    print("  · %s — %s" % (where, headline), file=sys.stderr)
print("", file=sys.stderr)
print(data.get("markdown", ""), file=sys.stderr)
'
echo "确认后重推：JEV_ALLOW_PUSH=1 git push（本次确属夹具/文档示例时）；或先修掉这些内容。" >&2
echo "永久跳过本仓库：JEV_SKIP_PRIVACY=1 git push，或删除 .git/hooks/pre-push。" >&2

[ "${JEV_ALLOW_PUSH:-0}" = "1" ] && exit 0
exit 1
